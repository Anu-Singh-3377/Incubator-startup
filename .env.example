# ==============================================================================
# VentureBharat Incubation Center - Environment Configuration
# ============================================================================

# Supabase browser credentials (publishable/anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side secret. Never use a VITE_ prefix or expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Resend Email Delivery API (optional)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=VentureBharat Incubation <onboarding@resend.dev>
